#include <stdio.h>
int main() {
    int a = 10, b = 5;

    // Arithmetic
    printf("Arithmetic: a+b=%d, a-b=%d, a*b=%d, a/b=%d\n", a+b, a-b, a*b, a/b);

    // Relational
    printf("Relational: a>b=%d, a<b=%d, a==b=%d\n", a>b, a<b, a==b);

    // Logical
    printf("Logical: (a>b && b>0)=%d, (a<b || b>0)=%d, !(a==b)=%d\n", (a>b && b>0), (a<b || b>0), !(a==b));

    return 0;
}
